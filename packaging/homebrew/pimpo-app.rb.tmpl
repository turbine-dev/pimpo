# The desktop app: brew install --cask turbine-dev/tap/pimpo-app
# Filled in by the release workflow (scripts/cask.py); do not edit the copy
# in the tap by hand.
cask "pimpo-app" do
  arch arm: "arm64", intel: "amd64"

  version "@VERSION@"
  sha256 arm:   "@SHA_ARM64@",
         intel: "@SHA_AMD64@"

  url "https://github.com/turbine-dev/pimpo/releases/download/v#{version}/Pimpo_#{version}_macos_#{arch}.dmg"
  name "Pimpo"
  desc "Personal AI agent that learns a task once, then does it on its own"
  homepage "https://github.com/turbine-dev/pimpo"

  depends_on macos: ">= :big_sur"
  auto_updates true

  app "Pimpo.app"

  zap trash: [
    "~/.pimpo",
    "~/Library/Application Support/app.pimpo.desktop",
    "~/Library/Caches/app.pimpo.desktop",
    "~/Library/WebKit/app.pimpo.desktop",
  ]
end
