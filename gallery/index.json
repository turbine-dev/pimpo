  {
   "id": "nao-lidos-por-remetente",
   "author": "dener",
   "routine": {
    "name": "Não lidos por remetente",
    "description": "De manhã, quantos e-mails não lidos chegaram e de quem.",
    "manifest": {
     "schedule": "15 7 * * *",
     "capabilities": [
      "gmail.search",
      "telegram.send"
     ],
     "locale": "pt-BR"
    },
    "code": "async function run() {\n  const mails = await gmail.search({query: \"is:unread\", days: 1, max: 50});\n  if (!mails.length) { await telegram.send({text: \"📭 Nada novo desde ontem.\"}); return; }\n  const by = {};\n  for (const m of mails) by[m.from_name] = (by[m.from_name] || 0) + 1;\n  const top = Object.entries(by).sort((a, b) =\u003e b[1] - a[1]).slice(0, 5);\n  await telegram.send({text: \"📬 \" + mails.length + \" não lidos. Mais frequentes:\\n\" + top.map(([n, c]) =\u003e \"• \" + n + \" (\" + c + \")\").join(\"\\n\")});\n}",
    "tests": [
     {
      "name": "vários",
      "now": "2026-09-24T07:00:00-03:00",
      "responses": [
       {
        "capability": "gmail.search",
        "result": [
