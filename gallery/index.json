       "name": "quantos",
       "label": "Quantos remetentes mostrar",
       "type": "number",
       "default": 5
      },
      {
       "name": "destinos",
       "label": "Onde avisar",
       "type": "destinations",
       "default": []
      }
     ]
    },
    "code": "async function run() {\n  const mails = await gmail.search({query: \"is:unread\", days: 1, max: 50});\n  if (!mails.length) { await notify.send({text: \"📭 Nada novo desde ontem.\"}); return; }\n  const by = {};\n  for (const m of mails) by[m.from_name] = (by[m.from_name] || 0) + 1;\n  const top = Object.entries(by).sort((a, b) =\u003e b[1] - a[1]).slice(0, params.quantos);\n  await notify.send({text: \"📬 \" + mails.length + \" não lidos. Mais frequentes:\\n\" + top.map(([n, c]) =\u003e \"• \" + n + \" (\" + c + \")\").join(\"\\n\")});\n}",
