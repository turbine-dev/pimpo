          "from_name": "ana",
          "to": [
           "eu@exemplo.com"
          ],
          "subject": "b",
          "snippet": "",
          "date": "2026-09-23T10:00:00-03:00",
          "labels": [
           "INBOX"
          ],
          "replied": false,
          "unread": true,
          "can_unsubscribe": false
         },
         {
          "id": "3",
          "from": "bot@y.com",
