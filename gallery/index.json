    "code": "async function run() {\n  const found = [];\n  for (const q of params.palavras.split(\",\").map(s =\u003e s.trim()).filter(Boolean)) {\n    for (const m of await gmail.search({query: q, days: params.dias, max: 30})) {\n      if (!found.some(f =\u003e f.id === m.id)) found.push(m);\n    }\n  }\n  if (!found.length) { await notify.send({text: \"💸 Nenhuma conta nova esta semana.\"}); return; }\n  const lines = found.map(m =\u003e {\n    const v = money.parse(money.find(m.subject + \" \" + m.snippet) || \"\");\n    return \"• \" + m.from_name + \": \" + m.subject + (v ? \" — \" + money.format(v, \"BRL\") : \"\");\n  });\n  await notify.send({text: \"💸 Contas da semana:\\n\" + lines.join(\"\\n\")});\n}",
