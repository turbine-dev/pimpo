  {
   "id": "clima-da-manha",
   "author": "dener",
   "routine": {
    "name": "Clima da manhã",
    "description": "Previsão do dia na cidade que você escolher, com aviso de guarda-chuva.",
    "manifest": {
     "schedule": "0 7 * * *",
     "capabilities": [
      "http.getJSON:api.open-meteo.com",
      "notify.send"
     ],
     "locale": "pt-BR",
     "params": [
      {
       "name": "cidade",
       "label": "Cidade",
       "type": "location",
       "default": {
        "latitude": -23.55,
        "longitude": -46.63,
        "name": "São Paulo",
        "timezone": "America/Sao_Paulo"
       }
      },
      {
       "name": "chuva",
       "label": "Avisar guarda-chuva a partir de (% de chuva)",
       "type": "number",
       "default": 50
      },
      {
       "name": "destinos",
       "label": "Onde avisar",
       "type": "destinations",
       "default": []
      }
     ]
    },
    "code": "async function run() {\n  const w = await http.getJSON(\"https://api.open-meteo.com/v1/forecast?latitude=\" + params.cidade.latitude + \"\u0026longitude=\" + params.cidade.longitude + \"\u0026daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max\u0026timezone=auto\u0026forecast_days=1\");\n  const d = w.daily;\n  let text = \"🌤️ \" + params.cidade.name + \" hoje: mínima de \" + Math.round(d.temperature_2m_min[0]) + \"°, máxima de \" + Math.round(d.temperature_2m_max[0]) + \"°.\";\n  if (d.precipitation_probability_max[0] \u003e= params.chuva) text += \" ☔ Leve guarda-chuva (\" + d.precipitation_probability_max[0] + \"% de chuva).\";\n  await notify.send({text});\n}",
    "tests": [
     {
      "name": "dia de chuva",
      "now": "2026-09-24T07:00:00-03:00",
      "responses": [
       {
        "capability": "http.getJSON",
        "result": {
         "daily": {
          "temperature_2m_max": [
           24.6
          ],
          "temperature_2m_min": [
           16.2
          ],
          "precipitation_probability_max": [
           80
          ]
         }
        }
       }
      ],
      "expect": [
       {
        "capability": "notify.send",
        "count": 1,
        "contains": [
         "mínima de 16°",
         "máxima de 25°",
         "guarda-chuva"
        ]
       }
      ]
     },
     {
      "name": "dia seco",
      "now": "2026-09-24T07:00:00-03:00",
      "responses": [
       {
        "capability": "http.getJSON",
        "result": {
         "daily": {
          "temperature_2m_max": [
           30
          ],
          "temperature_2m_min": [
           19
          ],
          "precipitation_probability_max": [
           5
          ]
         }
        }
       }
      ],
      "expect": [
       {
        "capability": "notify.send",
        "count": 1,
        "contains": [
         "máxima de 30°"
        ],
        "not_contains": [
         "guarda-chuva"
        ]
       }
      ]
     },
     {
      "name": "Lisboa, só avisa com 90% de chuva",
      "now": "2026-09-24T07:00:00-03:00",
      "responses": [
       {
        "capability": "http.getJSON",
        "result": {
         "daily": {
          "temperature_2m_max": [
           24.6
          ],
          "temperature_2m_min": [
           16.2
          ],
          "precipitation_probability_max": [
           80
          ]
         }
        }
       }
      ],
      "expect": [
       {
        "capability": "notify.send",
        "count": 1,
        "contains": [
         "Lisboa hoje",
         "máxima de 25°"
        ],
        "not_contains": [
         "guarda-chuva"
        ]
       }
      ],
      "params": {
       "chuva": 90,
       "cidade": {
        "latitude": 38.72,
        "longitude": -9.14,
        "name": "Lisboa"
       }
      }
     }
    ]
   },
   "hash": "71b49c4147f02f538e6f65a934a4afb708712b4aa89fb24f9e8b69a3593d9669",
