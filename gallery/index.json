   "routine": {
    "name": "Arquivar promoções",
    "description": "Todo dia, tira da caixa de entrada as promoções com mais de uma semana. Dá para desfazer.",
    "manifest": {
     "schedule": "0 22 * * *",
     "capabilities": [
      "gmail.search",
      "gmail.archive",
      "telegram.send"
     ],
     "locale": "pt-BR"
    },
    "code": "async function run() {\n  const mails = await gmail.search({query: \"category:promotions older_than:7d in:inbox\", max: 50});\n  for (const m of mails) await gmail.archive({id: m.id});\n  if (mails.length) await telegram.send({text: \"🧹 Arquivei \" + mails.length + (mails.length === 1 ? \" promoção antiga.\" : \" promoções antigas.\")});\n}",
