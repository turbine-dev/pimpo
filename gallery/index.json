  {
   "id": "arquivar-promocoes",
   "author": "dener",
   "routine": {
    "name": "Arquivar promoções",
    "description": "Todo dia, tira da caixa de entrada as promoções com mais de uma semana. Dá para desfazer.",
    "manifest": {
     "schedule": "0 22 * * *",
     "capabilities": [
      "gmail.search",
      "gmail.archive",
      "notify.send"
     ],
     "locale": "pt-BR",
     "params": [
      {
       "name": "dias",
       "label": "Arquivar promoções com mais de (dias)",
       "type": "number",
       "default": 7
      },
      {
       "name": "destinos",
       "label": "Onde avisar",
       "type": "destinations",
       "default": []
      }
     ]
    },
    "code": "async function run() {\n  const mails = await gmail.search({query: \"category:promotions older_than:\" + params.dias + \"d in:inbox\", max: 50});\n  for (const m of mails) await gmail.archive({id: m.id});\n  if (mails.length) await notify.send({text: \"🧹 Arquivei \" + mails.length + (mails.length === 1 ? \" promoção antiga.\" : \" promoções antigas.\")});\n}",
