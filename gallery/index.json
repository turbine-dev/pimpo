  {
   "id": "contas-da-semana",
   "author": "dener",
   "routine": {
    "name": "Contas que chegaram",
    "description": "Toda sexta, lista as contas que chegaram, com os valores. Você escolhe as palavras que indicam uma conta.",
    "manifest": {
     "schedule": "0 9 * * 5",
     "capabilities": [
      "gmail.search",
      "notify.send"
     ],
     "locale": "pt-BR",
     "params": [
      {
       "name": "palavras",
       "label": "Palavras que indicam uma conta",
       "type": "text",
       "default": "boleto, fatura",
       "help": "separadas por vírgula"
      },
      {
       "name": "dias",
       "label": "Olhar os últimos (dias)",
       "type": "number",
