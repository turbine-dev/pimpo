    "description": "De manhã, quantos e-mails não lidos chegaram e de quem.",
    "manifest": {
     "schedule": "15 7 * * *",
     "capabilities": [
      "gmail.search",
      "notify.send"
     ],
     "locale": "pt-BR",
     "params": [
