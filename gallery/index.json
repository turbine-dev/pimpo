          "bid": "6.02",
          "pctChange": "0.1"
         }
        }
       }
      ],
      "expect": [
       {
        "capability": "notify.send",
        "count": 1,
        "contains": [
         "EUR:",
         "6,02",
         "+0,10%"
        ]
       }
      ],
      "params": {
       "moeda": "EUR"
      }
     }
    ]
   },
