{
 "name": "Não lidos por remetente",
 "description": "De manhã, quantos e-mails não lidos chegaram e de quem.",
 "manifest": {
  "schedule": "15 7 * * *",
  "capabilities": [
   "gmail.search",
   "telegram.send"
  ],
  "locale": "pt-BR"
 },
 "code": "async function run() {\n  const mails = await gmail.search({query: \"is:unread\", days: 1, max: 50});\n  if (!mails.length) { await telegram.send({text: \"📭 Nada novo desde ontem.\"}); return; }\n  const by = {};\n  for (const m of mails) by[m.from_name] = (by[m.from_name] || 0) + 1;\n  const top = Object.entries(by).sort((a, b) => b[1] - a[1]).slice(0, 5);\n  await telegram.send({text: \"📬 \" + mails.length + \" não lidos. Mais frequentes:\\n\" + top.map(([n, c]) => \"• \" + n + \" (\" + c + \")\").join(\"\\n\")});\n}",
 "tests": [
  {
   "name": "vários",
   "now": "2026-09-24T07:00:00-03:00",
   "responses": [
    {
     "capability": "gmail.search",
     "result": [
      {
       "id": "1",
       "from": "ana@x.com",
       "from_name": "ana",
       "to": [
        "eu@exemplo.com"
       ],
       "subject": "a",
       "snippet": "",
       "date": "2026-09-23T10:00:00-03:00",
       "labels": [
        "INBOX"
       ],
       "replied": false,
       "unread": true,
       "can_unsubscribe": false
      },
      {
       "id": "2",
       "from": "ana@x.com",
       "from_name": "ana",
       "to": [
        "eu@exemplo.com"
       ],
       "subject": "b",
       "snippet": "",
       "date": "2026-09-23T10:00:00-03:00",
       "labels": [
        "INBOX"
       ],
       "replied": false,
       "unread": true,
       "can_unsubscribe": false
      },
      {
       "id": "3",
       "from": "bot@y.com",
       "from_name": "bot",
       "to": [
        "eu@exemplo.com"
       ],
       "subject": "c",
       "snippet": "",
       "date": "2026-09-23T10:00:00-03:00",
       "labels": [
        "INBOX"
       ],
       "replied": false,
       "unread": true,
       "can_unsubscribe": false
      },
      {
       "id": "4",
       "from": "lido@z.com",
       "from_name": "lido",
       "to": [
        "eu@exemplo.com"
       ],
       "subject": "d",
       "snippet": "",
       "date": "2026-09-23T10:00:00-03:00",
       "labels": [
        "INBOX"
       ],
       "replied": false,
       "unread": false,
       "can_unsubscribe": false
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "telegram.send",
     "count": 1,
     "contains": [
      "3 não lidos",
      "ana (2)",
      "bot (1)"
     ],
     "not_contains": [
      "lido ("
     ]
    }
   ]
  },
  {
   "name": "nenhum",
   "now": "2026-09-24T07:00:00-03:00",
   "responses": [
    {
     "capability": "gmail.search",
     "result": []
    }
   ],
   "expect": [
    {
     "capability": "telegram.send",
     "count": 1,
     "contains": [
      "Nada novo"
     ]
    }
   ]
  }
 ]
}