     "capability": "http.getJSON",
     "result": {
      "type": "FeatureCollection",
      "features": [
       {
        "type": "Feature",
        "id": "us7000a111",
        "properties": {
         "mag": 4.2,
         "place": "30 km W of Lima, Peru",
         "time": 1791295200000,
         "url": "https://earthquake.usgs.gov/earthquakes/eventpage/us7000a111"
        },
        "geometry": {
         "type": "Point",
         "coordinates": [
          -77.3,
          -12.1,
          40
         ]
        }
       },
       {
        "type": "Feature",
        "id": "us7000a222",
        "properties": {
         "mag": 5.0,
         "place": "80 km S of Lima, Peru",
         "time": 1791298800000,
         "url": "https://earthquake.usgs.gov/earthquakes/eventpage/us7000a222"
        },
        "geometry": {
         "type": "Point",
         "coordinates": [
          -76.9,
          -12.8,
          35
         ]
        }
       },
       {
        "type": "Feature",
        "id": "us7000old1",
        "properties": {
         "mag": 4.8,
         "place": "Lima, Peru",
         "time": 1791280000000,
         "url": "https://earthquake.usgs.gov/earthquakes/eventpage/us7000old1"
        },
        "geometry": {
         "type": "Point",
         "coordinates": [
          -77.0,
          -12.0,
          50
         ]
        }
       }
      ]
     }
    }
   ],
   "expect": [
    {
     "capability": "notify.send",
     "count": 1,
     "contains": [
      "M 5,0",
      "M 4,2",
      "80 km S of Lima"
     ],
     "not_contains": [
      "us7000old1"
     ]
    }
   ],
   "expect_state": {
    "avisados": [
     "us7000old1",
     "us7000a222",
     "us7000a111"
    ]
   }
  }
 ]
}
