{
 "name": "Aniversários da semana",
 "description": "Domingo à noite, os aniversários dos próximos sete dias.",
 "manifest": {
  "schedule": "0 19 * * 0",
  "capabilities": [
   "calendar.events",
   "notify.send"
  ],
  "locale": "pt-BR",
  "params": [
   {
    "name": "palavras",
    "label": "Palavras que indicam aniversário",
    "type": "text",
    "default": "aniversário, birthday",
    "help": "separadas por vírgula"
   },
   {
    "name": "destinos",
    "label": "Onde avisar",
    "type": "destinations",
    "default": []
   }
  ]
 },
 "code": "async function run() {\n  const today = dates.today();\n  const events = await calendar.events({from: today, to: dates.startOfDay(today, 7)});\n  const words = params.palavras.toLowerCase().split(\",\").map(s => s.trim()).filter(Boolean);\n  const birthdays = events.filter(e => words.some(w => e.title.toLowerCase().includes(w)));\n  if (!birthdays.length) return;\n  await notify.send({text: \"🎂 Aniversários da semana:\\n\" + birthdays.map(e => \"• \" + dates.format(e.start, \"EEE dd/MM\") + \": \" + e.title).join(\"\\n\")});\n}",
 "tests": [
  {
   "name": "dois aniversários",
   "now": "2026-09-27T19:00:00-03:00",
   "responses": [
    {
     "capability": "calendar.events",
     "result": [
      {
       "id": "Aniversário da Ana",
       "title": "Aniversário da Ana",
       "start": "2026-09-29T00:00:00-03:00",
       "end": "2026-09-30T00:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      },
      {
       "id": "Reunião",
       "title": "Reunião",
       "start": "2026-09-29T10:00:00-03:00",
       "end": "2026-09-29T11:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      },
      {
       "id": "Rui's birthday",
       "title": "Rui's birthday",
       "start": "2026-10-01T00:00:00-03:00",
       "end": "2026-10-02T00:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "notify.send",
     "count": 1,
     "contains": [
      "Aniversário da Ana",
      "Rui's birthday"
     ],
     "not_contains": [
      "Reunião"
     ]
    }
   ]
  },
  {
   "name": "nenhum",
   "now": "2026-09-27T19:00:00-03:00",
   "responses": [
    {
     "capability": "calendar.events",
     "result": [
      {
       "id": "Reunião",
       "title": "Reunião",
       "start": "2026-09-29T10:00:00-03:00",
       "end": "2026-09-29T11:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "notify.send",
     "count": 0
    }
   ]
  },
  {
   "name": "só em português",
   "now": "2026-09-27T19:00:00-03:00",
   "responses": [
    {
     "capability": "calendar.events",
     "result": [
      {
       "id": "Aniversário da Ana",
       "title": "Aniversário da Ana",
       "start": "2026-09-29T00:00:00-03:00",
       "end": "2026-09-30T00:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      },
      {
       "id": "Reunião",
       "title": "Reunião",
       "start": "2026-09-29T10:00:00-03:00",
       "end": "2026-09-29T11:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      },
      {
       "id": "Rui's birthday",
       "title": "Rui's birthday",
       "start": "2026-10-01T00:00:00-03:00",
       "end": "2026-10-02T00:00:00-03:00",
       "location": "",
       "attendees": [],
       "calendar": "pessoal"
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "notify.send",
     "count": 1,
     "contains": [
      "Aniversário da Ana"
     ],
     "not_contains": [
      "Rui's birthday",
      "Reunião"
     ]
    }
   ],
   "params": {
    "palavras": "aniversário"
   }
  }
 ]
}