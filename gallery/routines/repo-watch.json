{
 "name": "Atividade do GitHub no Discord",
 "description": "A cada 6 horas, verifica issues e PRs abertos no repositório GitHub configurado e avisa no Discord sobre os que tiveram atividade (campo \"updated\") nas últimas 6 horas, com título e link. Não envia nada quando não há atividade recente.",
 "manifest": {
  "schedule": "0 */6 * * *",
  "capabilities": [
   "github.issues",
   "discord.send"
  ],
  "locale": "pt-BR",
  "params": [
   {
    "name": "repo",
    "label": "Repositório GitHub (owner/nome)",
    "type": "text",
    "default": "acme/app",
    "help": "Ex.: acme/app"
   }
  ]
 },
 "code": "async function run() {\n  const repo = params.repo;\n  const issues = await github.issues({ repo, state: \"open\", max: 50 });\n  const cutoff = dates.addHours(now(), -6);\n\n  const recent = (issues || []).filter(i => i.updated && !dates.isBefore(i.updated, cutoff));\n\n  if (recent.length === 0) {\n    log(\"Nenhuma issue/PR com atividade nas últimas 6h em \" + repo);\n    return;\n  }\n\n  const lines = recent.map(i => {\n    const prefix = i.pull_request ? (\"PR #\" + i.number) : (\"#\" + i.number);\n    return \"• \" + prefix + \" \" + i.title + \" — \" + i.url;\n  });\n\n  const text = \"🐙 \" + repo + \" nas últimas 6h:\\n\" + lines.join(\"\\n\");\n  await discord.send({ text });\n}\n",
 "tests": [
  {
   "name": "Várias issues e PRs com atividade recente, uma antiga excluída",
   "now": "2026-09-28T18:00:00Z",
   "responses": [
    {
     "capability": "github.issues",
     "result": [
      {
       "number": 501,
       "title": "Erro ao exportar CSV",
       "author": "ana",
       "labels": [],
       "pull_request": false,
       "state": "open",
       "updated": "2026-09-28T15:00:00Z",
       "url": "https://github.com/acme/app/issues/501"
      },
      {
       "number": 502,
       "title": "Refatorar módulo de pagamentos",
       "author": "bruno",
       "labels": [],
       "pull_request": true,
       "state": "open",
       "updated": "2026-09-28T16:30:00Z",
       "url": "https://github.com/acme/app/pull/502"
      },
      {
       "number": 503,
       "title": "Atualizar dependências",
       "author": "carla",
       "labels": [],
       "pull_request": false,
       "state": "open",
       "updated": "2026-09-28T08:00:00Z",
       "url": "https://github.com/acme/app/issues/503"
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "discord.send",
     "count": 1,
     "contains": [
      "#501",
      "PR #502"
     ],
     "not_contains": [
      "#503"
     ]
    }
   ]
  },
  {
   "name": "Nada com atividade recente - não envia mensagem",
   "now": "2026-09-28T18:00:00Z",
   "responses": [
    {
     "capability": "github.issues",
     "result": [
      {
       "number": 600,
       "title": "Issue antiga sem novidade",
       "author": "x",
       "labels": [],
       "pull_request": false,
       "state": "open",
       "updated": "2026-09-28T05:00:00Z",
       "url": "https://github.com/acme/app/issues/600"
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "discord.send",
     "count": 0
    }
   ]
  },
  {
   "name": "Repositório diferente via parâmetro, itens em ordem e rótulos variados",
   "now": "2026-09-28T18:00:00Z",
   "responses": [
    {
     "capability": "github.issues",
     "result": [
      {
       "number": 10,
       "title": "Add dark mode toggle",
       "author": "sam",
       "labels": [
        "enhancement"
       ],
       "pull_request": true,
       "state": "open",
       "updated": "2026-09-28T17:00:00Z",
       "url": "https://github.com/acme/website/pull/10"
      },
      {
       "number": 9,
       "title": "Fix broken footer link",
       "author": "lee",
       "labels": [],
       "pull_request": false,
       "state": "open",
       "updated": "2026-09-28T14:00:00Z",
       "url": "https://github.com/acme/website/issues/9"
      }
     ]
    }
   ],
   "expect": [
    {
     "capability": "discord.send",
     "count": 1,
     "contains": [
      "acme/website",
      "PR #10",
      "#9"
     ]
    }
   ],
   "params": {
    "repo": "acme/website"
   }
  }
 ]
}
