{
 "name": "Resumo diário matinal",
 "description": "Todo dia útil às 7h envia no Telegram (ou destino escolhido) um resumo: previsão do tempo, agenda do dia, e-mails não lidos realmente importantes e tarefas do Todoist de hoje ou atrasadas.",
 "manifest": {
  "schedule": "0 7 * * 1-5",
  "capabilities": [
   "http.getJSON:api.open-meteo.com",
   "calendar.events",
   "gmail.search",
   "todoist.tasks",
   "notify.send"
  ],
  "judgments": {
   "important": "Este e-mail não lido é realmente importante e exige atenção do dono hoje (algo urgente, cobrança, prazo, escalada de trabalho), e não é promocional, automático ou de baixa prioridade?"
  },
  "params": [
   {
    "name": "location",
    "label": "Cidade para o clima",
    "type": "location",
    "default": {
     "latitude": -23.55,
     "longitude": -46.63,
     "name": "São Paulo",
     "timezone": "America/Sao_Paulo"
    }
   },
   {
    "name": "destinos",
    "label": "Onde avisar",
    "type": "destinations",
    "default": []
   }
  ]
 },
 "code": "async function run() {\n  const loc = params.location || {latitude: -23.55, longitude: -46.63, name: 'São Paulo'};\n  const lat = loc.latitude;\n  const lon = loc.longitude;\n  const cityName = loc.name || 'sua cidade';\n\n  const today = dates.today();\n  const tomorrow = dates.addDays(today, 1);\n\n  // 1. Weather\n  const weatherUrl = 'https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon + '&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=America%2FSao_Paulo&forecast_days=1';\n  const weather = await http.getJSON(weatherUrl);\n  let weatherLine = '';\n  if (weather && weather.daily && weather.daily.temperature_2m_max && weather.daily.temperature_2m_max.length > 0) {\n    const tmax = Math.round(weather.daily.temperature_2m_max[0]);\n    const tmin = Math.round(weather.daily.temperature_2m_min[0]);\n    const rain = weather.daily.precipitation_probability_max[0];\n    const emoji = rain >= 50 ? '🌧️' : '☀️';\n    weatherLine = emoji + ' Bom dia! ' + cityName + ': ' + tmin + '° a ' + tmax + '°, ' + rain + '% de chance de chuva.';\n  } else {\n    weatherLine = '☀️ Bom dia! Previsão do tempo indisponível.';\n  }\n\n  // 2. Calendar\n  const events = await calendar.events({from: today, to: tomorrow});\n  events.sort((a, b) => (a.start < b.start ? -1 : 1));\n  let agendaLine;\n  if (events.length === 0) {\n    agendaLine = '📅 Nenhum compromisso hoje.';\n  } else {\n    const parts = events.map(function(e) {\n      const time = e.start.length > 10 ? dates.format(e.start, 'HH:mm') : 'Dia todo';\n      return time + ' ' + e.title;\n    });\n    agendaLine = '📅 ' + parts.join(' · ');\n  }\n\n  // 3. Emails\n  const emails = await gmail.search({query: 'in:inbox is:unread', days: 1, unread: true, max: 20});\n  const important = [];\n  for (const email of emails) {\n    const res = await judge.important(email);\n    if (res.p >= 0.5) important.push(email);\n  }\n  let emailsLine;\n  if (important.length === 0) {\n    emailsLine = '📩 Nenhum e-mail importante.';\n  } else {\n    const parts = important.map(function(e) {\n      return e.subject + ' (' + (e.from_name || e.from) + ')';\n    });\n    emailsLine = '📩 ' + parts.join(' · ');\n  }\n\n  // 4. Todoist\n  const tasks = await todoist.tasks({filter: 'today | overdue'});\n  let tasksLine;\n  if (!tasks || tasks.length === 0) {\n    tasksLine = '✅ Nenhuma tarefa para hoje.';\n  } else {\n    const parts = tasks.map(function(t) {\n      const dueDate = t.due && t.due.date ? t.due.date : null;\n      const overdue = dueDate && dates.isBefore(dueDate, today);\n      return t.content + (overdue ? ' (atrasada)' : '');\n    });\n    tasksLine = '✅ ' + parts.join(' · ');\n  }\n\n  const text = [weatherLine, agendaLine, emailsLine, tasksLine].join('\\n');\n  log(text);\n  await notify.send({text: text});\n}\n",
